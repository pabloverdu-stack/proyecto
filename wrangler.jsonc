{
  // Configuración de Cloudflare Workers. El adaptador de Astro completa el resto al compilar.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ficha-viva",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
}
