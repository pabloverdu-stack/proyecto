# Copia este archivo como .env y rellena los valores. NUNCA subas .env a Git.
# Sin claves, en desarrollo la web funciona en MODO DEMO (pagos simulados y datos en memoria).
# Guía paso a paso en README.md.

# Dominio público (sin barra final)
SITE_URL=

# Stripe: usa claves de TEST (sk_test_…) hasta que decidas cobrar de verdad
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (Project Settings > API). La service_role es secreta: solo en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New), para buscar el negocio en /pedido
GOOGLE_PLACES_API_KEY=

# Emails con Resend
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=

# Opcional: webhook de n8n que recibe cada pedido pagado
N8N_WEBHOOK_URL=

# Medición. Si están vacías no se carga nada ni aparece el aviso de cookies.
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
PUBLIC_OPENAI_PIXEL_ID=
