---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}

const { title, description, path, updated } = Astro.props;
---

<Base
  title={title}
  description={description}
  path={path}
  devWarning="PENDIENTE DE REVISIÓN PROFESIONAL. Borrador con datos entre [CORCHETES]. Este aviso solo se ve en desarrollo."
>
  <article class="container legal">
    <h1 class="h1">{title}</h1>
    <p class="muted updated">Última actualización: {updated}</p>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: 48rem;
    padding-block: var(--space-10) var(--section-gap);
  }

  .updated {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .prose {
    margin-top: var(--space-8);
  }

  .prose :global(h2) {
    margin: var(--space-10) 0 var(--space-3);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .prose :global(h3) {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table) {
    margin-bottom: var(--space-4);
    max-width: var(--measure);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: var(--space-1);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(.table-wrap) {
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: var(--border-hair);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--color-grafito);
    font-weight: var(--weight-semibold);
  }

  .prose :global(.option) {
    margin-bottom: var(--space-4);
    padding: var(--space-4);
    border: 1px dashed var(--color-grafito);
    border-radius: var(--radius-md);
  }
</style>
