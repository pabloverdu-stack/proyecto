---
// Escena del producto dibujada en SVG: pesa unos pocos KB y no necesita fotos.
// state: "open" (móvil tocando y reseña abierta), "approach" (móvil acercándose),
// "done" (reseña publicada) o "idle" (sin móvil).
interface Props {
  variant: 'card' | 'stand';
  state?: 'open' | 'approach' | 'done' | 'idle';
  animated?: boolean;
  label: string;
  brand?: string;
  id?: string;
  class?: string;
}

const { variant, state = 'open', animated = false, label, brand = 'marca', id, class: className } = Astro.props;
const phoneOffset = state === 'approach' ? 'translate(118 -14)' : undefined;
const showPhone = state !== 'idle';
const showSheet = state === 'open';
const done = state === 'done';
const font = "'Chivo Variable', Chivo, system-ui, sans-serif";
---

<svg
  viewBox="0 0 600 400"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={label}
  id={id}
  class:list={['scene', className]}
  data-scene-animated={animated ? '' : undefined}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="600" height="400" fill="#E7E9E4"></rect>

  {
    variant === 'card' && (
      <g transform="rotate(-8 200 231)">
        <rect x="74" y="158" width="257" height="162" rx="11" fill="#17191A" opacity=".07" />
        <rect x="70" y="150" width="257" height="162" rx="11" fill="#FFFFFF" />
        <text x="92" y="184" font-family={font} font-weight="700" font-size="16" fill="#17191A">{brand}</text>
        <circle cx="300" cy="231" r="20" fill="none" stroke="#17191A" stroke-width="2" />
        <circle cx="300" cy="231" r="5" fill="#17191A" />
        <text x="92" y="272" font-family={font} font-size="11" fill="#5B6166">Acerca el móvil</text>
        <text x="92" y="290" font-family={font} font-size="11" fill="#17191A">Déjanos tu reseña en Google</text>
      </g>
    )
  }

  {
    variant === 'stand' && (
      <g>
        <line x1="0" y1="312" x2="600" y2="312" stroke="#CFD3CD" stroke-width="2" />
        <rect x="156" y="78" width="180" height="228" rx="12" fill="#17191A" opacity=".07" />
        <path d="M168 300 L322 300 L338 314 L152 314 Z" fill="#17191A" />
        <rect x="150" y="70" width="180" height="232" rx="12" fill="#FFFFFF" />
        <text x="170" y="104" font-family={font} font-weight="700" font-size="15" fill="#17191A">{brand}</text>
        <circle cx="285" cy="132" r="22" fill="none" stroke="#17191A" stroke-width="2" />
        <circle cx="285" cy="132" r="5.5" fill="#17191A" />
        <text x="170" y="232" font-family={font} font-size="11" fill="#5B6166">Acerca el móvil</text>
        <text x="170" y="252" font-family={font} font-size="11" fill="#17191A">Déjanos tu reseña</text>
        <text x="170" y="268" font-family={font} font-size="11" fill="#17191A">en Google</text>
      </g>
    )
  }

  {
    showPhone && variant === 'card' && (
      <g class="js-phone" transform={phoneOffset}>
        <g transform="translate(22 0) rotate(8 345 205)">
          <rect x="268" y="52" width="170" height="330" rx="28" fill="#17191A" opacity=".12" />
          <rect x="260" y="40" width="170" height="330" rx="28" fill="#17191A" />
          <rect x="268" y="48" width="154" height="314" rx="20" fill="#FFFFFF" />
          <rect x="325" y="56" width="40" height="6" rx="3" fill="#17191A" />
          {
            done && (
              <g>
                <circle cx="345" cy="186" r="30" fill="none" stroke="#17191A" stroke-width="3" />
                <path d="M330 187 L341 198 L361 175" fill="none" stroke="#17191A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                <text x="345" y="248" text-anchor="middle" font-family={font} font-weight="700" font-size="15" fill="#17191A">Reseña publicada</text>
                <text x="345" y="270" text-anchor="middle" font-family={font} font-size="11" fill="#5B6166">Tu negocio</text>
              </g>
            )
          }
          <g class="js-sheet" opacity={showSheet ? undefined : '0'}>
            <text x="282" y="98" font-family={font} font-weight="700" font-size="15" fill="#17191A">Tu negocio</text>
            <rect x="282" y="108" width="90" height="6" rx="3" fill="#CFD3CD" />
            <line x1="268" y1="128" x2="422" y2="128" stroke="#E7E9E4" stroke-width="2" />
            <text x="282" y="158" font-family={font} font-weight="600" font-size="12" fill="#17191A">Escribe tu reseña</text>
            <rect x="282" y="170" width="126" height="86" rx="8" fill="#FFFFFF" stroke="#CFD3CD" stroke-width="1.5" />
            <rect x="292" y="184" width="96" height="6" rx="3" fill="#E7E9E4" />
            <rect x="292" y="198" width="106" height="6" rx="3" fill="#E7E9E4" />
            <rect x="292" y="212" width="70" height="6" rx="3" fill="#E7E9E4" />
            <rect x="282" y="272" width="126" height="32" rx="8" fill="#17191A" />
            <text x="345" y="293" text-anchor="middle" font-family={font} font-weight="600" font-size="12" fill="#FFFFFF">Publicar</text>
          </g>
          <rect x="315" y="346" width="60" height="4" rx="2" fill="#CFD3CD" />
        </g>
      </g>
    )
  }

  {
    showPhone && variant === 'stand' && (
      <g class="js-phone" transform={phoneOffset}>
        <g transform="rotate(-12 345 185)">
          <rect x="278" y="52" width="150" height="290" rx="26" fill="#17191A" opacity=".12" />
          <rect x="270" y="40" width="150" height="290" rx="26" fill="#17191A" />
          <rect x="278" y="48" width="134" height="274" rx="19" fill="#FFFFFF" />
          <rect x="325" y="55" width="40" height="6" rx="3" fill="#17191A" />
          {
            done && (
              <g>
                <circle cx="345" cy="170" r="27" fill="none" stroke="#17191A" stroke-width="3" />
                <path d="M332 171 L342 181 L360 160" fill="none" stroke="#17191A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                <text x="345" y="226" text-anchor="middle" font-family={font} font-weight="700" font-size="13" fill="#17191A">Reseña publicada</text>
                <text x="345" y="246" text-anchor="middle" font-family={font} font-size="11" fill="#5B6166">Tu negocio</text>
              </g>
            )
          }
          <g class="js-sheet" opacity={showSheet ? undefined : '0'}>
            <text x="290" y="92" font-family={font} font-weight="700" font-size="14" fill="#17191A">Tu negocio</text>
            <rect x="290" y="101" width="80" height="6" rx="3" fill="#CFD3CD" />
            <line x1="278" y1="120" x2="412" y2="120" stroke="#E7E9E4" stroke-width="2" />
            <text x="290" y="148" font-family={font} font-weight="600" font-size="11" fill="#17191A">Escribe tu reseña</text>
            <rect x="290" y="160" width="110" height="74" rx="8" fill="#FFFFFF" stroke="#CFD3CD" stroke-width="1.5" />
            <rect x="299" y="173" width="84" height="6" rx="3" fill="#E7E9E4" />
            <rect x="299" y="186" width="92" height="6" rx="3" fill="#E7E9E4" />
            <rect x="299" y="199" width="60" height="6" rx="3" fill="#E7E9E4" />
            <rect x="290" y="250" width="110" height="30" rx="8" fill="#17191A" />
            <text x="345" y="270" text-anchor="middle" font-family={font} font-weight="600" font-size="11" fill="#FFFFFF">Publicar</text>
          </g>
          <rect x="315" y="308" width="60" height="4" rx="2" fill="#CFD3CD" />
        </g>
      </g>
    )
  }

  {
    animated && variant === 'card' && (
      <g transform="rotate(-8 200 231)">
        <circle class="js-pulse" cx="300" cy="231" r="20" fill="none" stroke="#17191A" stroke-width="2" opacity="0" />
      </g>
    )
  }
  {animated && variant === 'stand' && <circle class="js-pulse" cx="285" cy="132" r="22" fill="none" stroke="#17191A" stroke-width="2" opacity="0" />}
</svg>

<style>
  .scene {
    width: 100%;
    height: auto;
  }
</style>
