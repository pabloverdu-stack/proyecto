---
import Scene from './Scene.astro';
import { site, formatEuros } from '../config/site';
import { eachLabel, recommendedPack, unitsLabel, type Pack, type Product } from '../lib/products';

interface Props {
  product: Product;
  crossSellUrl?: string;
}

const { product, crossSellUrl } = Astro.props;
const d = product.data;
const rec = recommendedPack(product);
const multiple = d.packs.length > 1;
const female = d.unit.gender === 'f';
const cta = `Pedir mi ${d.unit.singular}`;
const ready = female ? 'Llega programada y lista para usar.' : 'Llega programado y listo para usar.';
const summary = (pack: Pack) => `${unitsLabel(product, pack.units)}, ${formatEuros(pack.priceCents)}`;
const sceneLabel = `Un móvil tocando ${female ? 'la' : 'el'} ${d.unit.singular} con la ventana para escribir la reseña abierta en la pantalla`;
---

<section class="hero container" aria-labelledby="producto-titulo">
  <div class="gallery">
    <Scene
      variant={d.visual}
      state="open"
      animated
      id="escena-producto"
      brand={site.name.toLowerCase()}
      label={sceneLabel}
      class="gallery-scene"
    />
    <button type="button" class="replay" data-scene-replay aria-controls="escena-producto" hidden>Ver cómo funciona</button>
  </div>

  <div class="buy">
    <h1 id="producto-titulo" class="h1">{d.headline}</h1>
    <p class="sub">{d.subheadline}</p>

    <form class="buy-form" id="formulario-compra" method="get" action="/pedido" data-buy-form data-product={product.id}>
      <input type="hidden" name="producto" value={product.id} />
      <fieldset class="packs" data-pricing>
        <legend class="packs-legend">{d.name}</legend>
        {
          multiple ? (
            <div class="pack-grid" style={`--packs: ${d.packs.length}`}>
              {d.packs.map((pack) => (
                <label class="pack">
                  <input type="radio" name="pack" value={pack.id} checked={pack.id === rec.id} data-summary={summary(pack)} />
                  <span class="pack-body">
                    {pack.recommended && <span class="pack-tag">Recomendado</span>}
                    <span class="pack-units">{unitsLabel(product, pack.units)}</span>
                    {pack.units > 1 && <span class="pack-each">{eachLabel(product, pack)}</span>}
                    <span class="pack-price">{formatEuros(pack.priceCents)}</span>
                  </span>
                </label>
              ))}
            </div>
          ) : (
            <p class="single-price">
              <span class="pack-price">{formatEuros(rec.priceCents)}</span>
              <input type="hidden" name="pack" value={rec.id} data-summary={summary(rec)} />
            </p>
          )
        }
      </fieldset>
      <p class="note">IVA incluido. Envío gratis a la {site.shipping.zone} en {site.shipping.time}.</p>
      <button type="submit" class="btn-buy is-block" data-buy-cta>{cta}</button>
      <p class="assure">Funciona con iPhone y Android. {ready}</p>
      {
        d.crossSell && crossSellUrl && (
          <p class="cross">
            <a href={crossSellUrl}>{d.crossSell.text}</a>
          </p>
        )
      }
      {import.meta.env.DEV && d.provisionalPrice && <p class="dev-flag">Precio provisional pendiente de confirmar. Este aviso solo se ve en desarrollo.</p>}
    </form>
  </div>
</section>

<div class="sticky-buy" data-sticky-buy hidden>
  <div class="sticky-inner">
    <p class="sticky-summary" data-sticky-summary>{summary(rec)}</p>
    <button type="submit" form="formulario-compra" class="btn-buy">{cta}</button>
  </div>
</div>

<script>
  import '../scripts/scene';
  import { track } from '../scripts/track';
  import { getAttribution } from '../scripts/attribution';

  const form = document.querySelector<HTMLFormElement>('[data-buy-form]');

  if (form) {
    const productId = form.dataset.product ?? '';
    const packInputs = [...form.querySelectorAll<HTMLInputElement>('input[name="pack"]')];
    const sticky = document.querySelector<HTMLElement>('[data-sticky-buy]');
    const stickySummary = document.querySelector<HTMLElement>('[data-sticky-summary]');
    const headerCta = document.querySelector<HTMLAnchorElement>('[data-header-cta]');
    const orderLinks = document.querySelectorAll<HTMLAnchorElement>('[data-order-link]');
    const cta = form.querySelector<HTMLElement>('[data-buy-cta]');

    const selected = () => packInputs.find((input) => input.type === 'hidden' || input.checked) ?? packInputs[0];

    const wanted = new URLSearchParams(location.search).get('pack');
    const preselect = packInputs.find((input) => input.type === 'radio' && input.value === wanted);
    if (preselect) preselect.checked = true;

    const orderHref = () => {
      const params = new URLSearchParams({ producto: productId, pack: selected()?.value ?? '' });
      for (const [key, value] of Object.entries(getAttribution())) params.set(key, value);
      return `/pedido?${params}`;
    };

    const sync = () => {
      const pack = selected();
      if (stickySummary && pack) stickySummary.textContent = pack.dataset.summary ?? '';
      const href = orderHref();
      if (headerCta) headerCta.href = href;
      orderLinks.forEach((link) => (link.href = href));
    };

    packInputs.forEach((input) => input.addEventListener('change', sync));
    sync();

    form.addEventListener('submit', () => {
      for (const [key, value] of Object.entries(getAttribution())) {
        let field = form.querySelector<HTMLInputElement>(`input[name="${key}"]`);
        if (!field) {
          field = document.createElement('input');
          field.type = 'hidden';
          field.name = key;
          form.append(field);
        }
        field.value = value;
      }
      track('hero_cta_click', { product: productId, pack: selected()?.value, placement: 'buy_box' });
    });

    orderLinks.forEach((link) =>
      link.addEventListener('click', () =>
        track('hero_cta_click', { product: productId, pack: selected()?.value, placement: link.dataset.orderLink }),
      ),
    );

    const pricing = form.querySelector('[data-pricing]');
    if (pricing) {
      const pricingObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          track('pricing_view', { product: productId });
          pricingObserver.disconnect();
        },
        { threshold: 0.6 },
      );
      pricingObserver.observe(pricing);
    }

    if (cta) {
      let ctaInView = true;
      let closingInView = false;
      const update = () => {
        const scrolledPast = !ctaInView && cta.getBoundingClientRect().top < 0;
        if (sticky) {
          sticky.hidden = !scrolledPast || closingInView;
          document.body.classList.toggle('has-sticky-buy', !sticky.hidden);
        }
        if (headerCta) {
          headerCta.classList.toggle('is-visible', scrolledPast);
          headerCta.setAttribute('aria-hidden', String(!scrolledPast));
          headerCta.tabIndex = scrolledPast ? 0 : -1;
        }
      };
      new IntersectionObserver(([entry]) => {
        ctaInView = Boolean(entry?.isIntersecting);
        update();
      }).observe(cta);
      const closing = document.querySelector('[data-closing]');
      if (closing) {
        new IntersectionObserver(([entry]) => {
          closingInView = Boolean(entry?.isIntersecting);
          update();
        }).observe(closing);
      }
    }
  }
</script>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: 0 var(--space-12);
  }

  .gallery {
    position: relative;
    margin-inline: calc(var(--gutter) * -1);
  }

  .gallery :global(.gallery-scene) {
    height: clamp(13.5rem, 56vw, 22rem);
  }

  .replay {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-3);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: var(--border-control);
    border-radius: var(--radius-full);
    background: var(--color-papel);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .buy {
    display: grid;
    align-content: start;
  }

  .sub {
    margin-top: var(--space-2);
    font-size: var(--text-lead);
    line-height: 1.5;
    max-width: 34rem;
  }

  .buy-form {
    margin-top: var(--space-4);
  }

  .packs {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .packs-legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .pack-grid {
    display: grid;
    grid-template-columns: repeat(var(--packs), minmax(0, 1fr));
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .pack {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .pack input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .pack-body {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-2) var(--space-3);
    border: var(--border-control);
    border-radius: var(--radius-md);
    background: var(--color-blanco);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .pack input:checked + .pack-body {
    padding: calc(var(--space-2) - 1px) calc(var(--space-3) - 1px);
    border: var(--border-selected);
  }

  .pack input:focus-visible + .pack-body {
    outline: 2px solid var(--color-tinta);
    outline-offset: 3px;
  }

  .pack-tag {
    position: absolute;
    top: -0.625rem;
    left: var(--space-2);
    padding: 0 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-tinta);
    color: var(--color-blanco);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    line-height: 1.25rem;
    white-space: nowrap;
  }

  .pack-price {
    order: 2;
    font-size: var(--text-price);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .pack-units {
    order: 1;
  }

  .pack-each {
    order: 3;
    color: var(--color-grafito);
    font-size: 0.75rem;
  }

  .single-price .pack-price {
    font-size: 1.5rem;
  }

  .note,
  .assure {
    margin-top: var(--space-2);
    color: var(--color-grafito);
    font-size: var(--text-xs);
  }

  .buy-form .btn-buy {
    margin-top: var(--space-3);
  }

  .cross {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .cross a {
    font-weight: var(--weight-semibold);
  }

  .dev-flag {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-tinta);
    font-size: var(--text-xs);
  }

  .sticky-buy {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: var(--color-papel);
    border-top: 1px solid var(--color-grafito);
  }

  .sticky-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .sticky-summary {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .sticky-inner .btn-buy {
    margin-left: auto;
    min-height: 3rem;
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-16);
      align-items: center;
      padding-block: var(--space-10) var(--space-16);
    }

    .gallery {
      margin-inline: 0;
    }

    .gallery :global(.gallery-scene) {
      height: auto;
      aspect-ratio: 3 / 2;
      border-radius: var(--radius-lg);
    }

    .sub {
      margin-top: var(--space-4);
    }

    .buy-form {
      margin-top: var(--space-6);
    }

    .packs-legend {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      margin-bottom: var(--space-3);
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
    }

    .pack-grid {
      grid-template-columns: 1fr;
      padding-top: 0;
    }

    .pack-body {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-base);
    }

    .pack input:checked + .pack-body {
      padding: calc(var(--space-3) - 1px) calc(var(--space-4) - 1px);
    }

    .pack-tag {
      position: static;
      order: 2;
      align-self: center;
    }

    .pack-each {
      order: 3;
      margin-left: auto;
      font-size: var(--text-xs);
    }

    .pack-price {
      order: 4;
    }

    .pack-body:not(:has(.pack-each)) .pack-price {
      margin-left: auto;
    }

    .buy-form .btn-buy {
      min-height: 3.5rem;
      margin-top: var(--space-4);
      font-size: 1.125rem;
    }

    .sticky-buy {
      display: none !important;
    }
  }
</style>
